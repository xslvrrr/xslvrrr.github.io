# Required server secrets. Leave empty in this template. Generate each value
# independently with a cryptographically secure secret manager or `openssl rand -base64 48`.
SESSION_SECRET=
EXPORT_SIGNING_SECRET=
PORTAL_CREDENTIALS_SECRET=
# Encrypts user-supplied AI provider credentials at rest.
AI_CREDENTIALS_SECRET=
# Signs short-lived Google Classroom desktop upload tokens.
CLASSROOM_SYNC_TOKEN_SECRET=
CRON_SECRET=

# Required server-side Supabase administrator connection. Never expose service-role keys to Vite.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required built-in assistant provider key. Keep server-only.
OPENROUTER_API_KEY=

# Stripe subscriptions. These values are server-only.
APP_URL=http://millennium-five.vercel.app
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# These must be active monthly AUD prices for exactly A$10 and A$30.
STRIPE_STUDY_PRICE_ID=
STRIPE_FRONTIER_PRICE_ID=
# Enable only after Stripe Tax registrations and settings are configured.
STRIPE_AUTOMATIC_TAX=false

# Monthly provider-cost ceilings in cents. These are usage safeguards, not prices.
AI_STUDY_MONTHLY_BUDGET_CENTS=600
AI_FRONTIER_MONTHLY_BUDGET_CENTS=2000

# Server-owned Study kill switches. Clients never decide these. Every one of them is ON unless the
# value is the literal string "false"; the reworked Flashcards experience has shipped and no longer
# needs a flag to reach an account.
# Allows POST /api/study/cutover to promote an account to normalized storage.
STUDY_NORMALIZED_CUTOVER_ENABLED=true
# Advertises offline review and sync to desktop clients after cutover.
STUDY_OFFLINE_SYNC_ENABLED=true
# Enables cloze, typed, sequence, compare, application, and image-occlusion cards. Rollback to legacy
# JSONB storage stops being possible once accounts author these.
STUDY_RICH_NOTES_ENABLED=true
# Enables source-grounded drafting. Drafts are always reviewed and approved by the user; this flag
# only controls whether the assistant may propose them at all.
STUDY_AI_WORKSHOP_ENABLED=true

# Local development mode. Deployment supplies its own runtime mode.
NODE_ENV=development

# Optional assistant request metadata. Keep localhost until deployment configuration is approved.
# OPENROUTER_HTTP_REFERER=http://millennium-five.vercel.app
# OPENROUTER_APP_TITLE=Millennium Dashboard

# Google Calendar remains approval-gated and unavailable without both optional values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Portal sync uses ordinary HTTP by default. Browser fallback is explicit opt-in.
PORTAL_DIRECT_SYNC_ENABLED=true
PORTAL_SYNC_ALLOW_BROWSER_FALLBACK=false
# PORTAL_SYNC_PREFER_BROWSER=false
# PORTAL_SYNC_BROWSER_ON_AUTH_FAILURE=false
# Required only when PORTAL_SYNC_ALLOW_BROWSER_FALLBACK=true. Millennium does
# not download or bundle Chromium in the web release.
# PUPPETEER_EXECUTABLE_PATH=/path/to/chromium
# PUPPETEER_HEADLESS=true

# DANGER: disabling Chromium sandbox weakens process isolation. Leave false unless
# deployment already supplies equivalent isolation and has reviewed this risk.
PUPPETEER_DISABLE_SANDBOX=false

# Past papers
# THSC Online catalogue indexing. Off unless the informal permission its licence anticipates has
# been obtained — see docs/past-papers-sources.md. NESA runs regardless and covers every official
# HSC paper.
PAST_PAPERS_THSC_ENABLED=false

# Root of the locally held paper library, containing downloads/manifest.json and the PDFs.
# Without it the catalogue still lists papers but none can be opened.
PAST_PAPERS_CORPUS_DIR=
