# Copy to `.env` and fill in. Values are secrets — never commit the filled-in copy.
#
# These were previously being supplied by the shell that launched the dev server, which meant
# every restart in a fresh terminal silently lost them: the app still boots, but Supabase throws
# on first use and logins fail with "Supabase is unavailable because SUPABASE_URL or
# SUPABASE_SERVICE_ROLE_KEY is missing". A file survives restarts.
#
# Check with: curl -s localhost:3000/api/readiness   ->   {"status":"ready"}

# --- Required: the app cannot serve a login without these ---

# Supabase project URL and service-role key (Project settings -> API).
# The service-role key bypasses row-level security; it is server-only and must never reach the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signing key for the millennium_session cookie. Any long random string.
# Changing it invalidates every existing session.
SESSION_SECRET=

# Encrypts saved portal credentials at rest, per user.
# Changing it makes already-stored credentials undecryptable, forcing everyone to log in again.
PORTAL_CREDENTIALS_SECRET=

# --- Optional: features degrade or switch off without these ---

# APP_URL=http://localhost:3000
# OPENROUTER_API_KEY=
# AI_CREDENTIALS_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_STUDY_PRICE_ID=
# STRIPE_FRONTIER_PRICE_ID=
# CRON_SECRET=
# EXPORT_SIGNING_SECRET=
# CLASSROOM_SYNC_TOKEN_SECRET=
# GITHUB_ISSUES_TOKEN=
# GITHUB_ISSUES_REPOSITORY=

# --- Local development only ---

# Sections to show even though they are still flagged unreleased (comma separated).
# Currently available: classroom, past-papers
# VITE_PRERELEASE_SECTIONS=classroom
