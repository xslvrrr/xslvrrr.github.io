{
  "include": [
    "src/**/*",
    "components/**/*",
    "hooks/**/*",
    "start/**/*",
    "lib/**/*",
    "types/**/*",
    "desktop/**/*",
    "scripts/**/*",
    "vite.config.ts",
    "vite.desktop.config.ts",
    "postcss.config.js",
    "eslint.config.js",
    "prettier.config.js"
  ],
  "exclude": [
    "node_modules",
    "out",
    "dist",
    "build"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*", "./*"]
    }
  }
}
