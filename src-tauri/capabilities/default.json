{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the Millennium localhost desktop UI",
  "local": false,
  "remote": {
    "urls": [
      "http://millennium-five.vercel.app/*",
      "http://localhost:3001/*",
      "http://localhost:3002/*",
      "http://localhost:3003/*",
      "http://localhost:3004/*",
      "http://localhost:3005/*",
      "http://localhost:3006/*",
      "http://localhost:3007/*",
      "http://localhost:3008/*",
      "http://localhost:3009/*",
      "http://localhost:3010/*",
      "http://localhost:14200/*"
    ]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "deep-link:default",
    "process:allow-restart",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "allow-set-window-controls-visible",
    "allow-detect-assistant-clis",
    "allow-run-assistant-cli",
    "allow-cancel-assistant-cli",
    "allow-detect-classroom-browsers",
    "allow-get-classroom-browser-permission",
    "allow-request-classroom-browser-permission",
    "allow-start-classroom-sync",
    "allow-continue-classroom-sync",
    "allow-get-classroom-sync-status",
    "allow-cancel-classroom-sync",
    "allow-disconnect-classroom",
    "allow-open-browser-permission-settings",
    "allow-get-classroom-automation-diagnostics",
    "allow-repair-classroom-automation",
    "allow-desktop-shell-status",
    "allow-desktop-shell-check",
    "allow-read-desktop-identity",
    "allow-write-desktop-identity",
    "allow-read-secure-cache",
    "allow-secure-cache-record-exists",
    "allow-write-secure-cache",
    "allow-read-saved-classroom-snapshot",
    "allow-delete-saved-classroom-snapshot",
    "allow-write-desktop-bootstrap",
    "allow-delete-secure-cache",
    "allow-clear-secure-owner",
    "allow-clear-secure-cache",
    "allow-study-local-status",
    "allow-study-local-library",
    "allow-study-local-apply-snapshot",
    "allow-study-local-apply-changes",
    "allow-study-local-record-review",
    "allow-study-local-pending",
    "allow-study-local-conflicts",
    "allow-study-local-resolve",
    "allow-study-local-discard-conflict",
    "allow-study-local-clear",
    {
      "identifier": "opener:allow-open-url",
          "allow": [
            { "url": "http://millennium-five.vercel.app/login*" },
            { "url": "http://localhost:3001/login*" },
            { "url": "http://localhost:3002/login*" },
            { "url": "http://localhost:3003/login*" },
            { "url": "http://localhost:3004/login*" },
            { "url": "http://localhost:3005/login*" },
            { "url": "http://localhost:3006/login*" },
            { "url": "http://localhost:3007/login*" },
            { "url": "http://localhost:3008/login*" },
            { "url": "http://localhost:3009/login*" },
            { "url": "http://localhost:3010/login*" },
            { "url": "http://localhost:14201/login*" },
            { "url": "http://millennium-five.vercel.app/download*" },
            { "url": "http://localhost:3001/download*" },
            { "url": "http://localhost:3002/download*" },
            { "url": "http://localhost:3003/download*" },
            { "url": "http://localhost:3004/download*" },
            { "url": "http://localhost:3005/download*" },
            { "url": "http://localhost:3006/download*" },
            { "url": "http://localhost:3007/download*" },
            { "url": "http://localhost:3008/download*" },
            { "url": "http://localhost:3009/download*" },
            { "url": "http://localhost:3010/download*" },
            { "url": "http://localhost:14201/download*" },
        { "url": "https://classroom.google.com/*" },
        { "url": "https://*.google.com/*" },
        { "url": "https://millennium.education/*" },
        { "url": "mailto:*" }
      ]
    }
  ]
}
