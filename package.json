{
  "name": "millennium-redesign",
  "version": "1.0.9",
  "private": true,
  "type": "module",
  "desktopShell": {
    "minimumNativeVersion": "1.0.9"
  },
  "packageManager": "bun@1.3.4",
  "engines": {
    "bun": ">=1.3.4",
    "node": "22.x"
  },
  "scripts": {
    "dev": "bun run dev:web --host",
    "dev:web": "vite dev --host localhost --port 3000 --strictPort --host",
    "dev:desktop:server": "vite dev --host localhost --port 14201 --strictPort",
    "dev:desktop:ui": "vite dev --config vite.desktop.config.ts",
    "dev:desktop": "bun run scripts/desktop-dev.ts",
    "build": "bun run build:web",
    "build:web": "bun run build:desktop:shell && bun run scripts/build-web.ts",
    "build:desktop:ui": "bun run scripts/build-desktop-ui.ts",
    "build:desktop:shell": "bun run build:desktop:ui && bun run scripts/publish-desktop-shell.ts",
    "preview": "vite preview --host localhost --port 3000 --strictPort",
    "desktop:dev": "bunx tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "bunx tauri build",
    "desktop:build:macos-arm64": "bunx tauri build --target aarch64-apple-darwin --bundles dmg",
    "desktop:build:macos-x64": "bunx tauri build --target x86_64-apple-darwin --bundles dmg",
    "desktop:build:macos-universal": "bunx tauri build --target universal-apple-darwin --bundles dmg",
    "desktop:build:windows-x64": "bunx tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "desktop:build:windows-arm64": "bunx tauri build --target aarch64-pc-windows-msvc --bundles nsis",
    "desktop:build:linux-x64": "bunx tauri build --target x86_64-unknown-linux-gnu --bundles appimage,deb",
    "desktop:build:linux-arm64": "bunx tauri build --target aarch64-unknown-linux-gnu --bundles appimage,deb",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:release": "bun run typecheck && bun run build:web",
    "test:desktop-links": "node --test lib/desktop/links.test.js",
    "test:desktop-version": "node --test lib/desktop/version.test.js",
    "test:assistant": "node --test lib/assistant/actions.test.js",
    "test:home-layout": "node --test components/dashboard/home/homeLayout.test.js components/dashboard/home/homePlacement.test.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "@lobehub/icons": "^5.14.0",
    "@phosphor-icons/react": "^2.1.10",
    "@remixicon/react": "^4.9.0",
    "@supabase/supabase-js": "^2.49.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-router": "1.170.4",
    "@tanstack/react-router-ssr-query": "^1.166.9",
    "@tanstack/react-start": "1.168.6",
    "@tanstack/router-plugin": "^1.166.13",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emojibase-data": "^17.0.0",
    "isomorphic-dompurify": "^2.28.0",
    "jsdom": "^28.1.0",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "nitro": "3.0.0",
    "pdfjs-dist": "^6.1.200",
    "puppeteer-core": "^25.3.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.0.19",
    "ts-fsrs": "5.4.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/eslint-config": "^0.4.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^20.19.0",
    "@types/react": "18.2.45",
    "@types/react-dom": "18.2.18",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "shadcn": "^4.10.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@types/react": "18.2.45"
  }
}
